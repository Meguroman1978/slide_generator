# OpenAI API Key (Required for AI analysis and slide generation)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Optional - Alternative AI provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Apps Script Web App URL (Required for Google Slides generation)
GOOGLE_APPS_SCRIPT_URL=your_google_apps_script_url_here

# Optional: Custom API endpoints
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
